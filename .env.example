# Palimpsest environment template. Copy to `.env` for local overrides.
# Variables with the PALIMPSEST_ prefix override values in this file.
# Importing application modules does not require this file or any secret.
# Never commit a real `.env` file.

PALIMPSEST_ENVIRONMENT=local
PALIMPSEST_LOG_LEVEL=INFO
PALIMPSEST_API_HOST=127.0.0.1
PALIMPSEST_API_PORT=8080

# Research API credentials (SecretStr). Never put secrets in query strings.
# When PALIMPSEST_API_AUTH_REQUIRED=true, control/inspection/agent-visible
# credentials are mandatory. Debug is disabled unless explicitly enabled.
PALIMPSEST_API_AUTH_REQUIRED=false
# PALIMPSEST_API_CONTROL_CREDENTIAL=
# PALIMPSEST_API_INSPECTION_CREDENTIAL=
# PALIMPSEST_API_AGENT_VISIBLE_CREDENTIAL=
PALIMPSEST_API_DEBUG_ENABLED=false
# PALIMPSEST_API_DEBUG_CREDENTIAL=
PALIMPSEST_API_MAX_PAGE_SIZE=100
PALIMPSEST_API_STREAM_QUEUE_SIZE=64
PALIMPSEST_API_STREAM_HEARTBEAT_SECONDS=15
PALIMPSEST_API_STREAM_POLL_SECONDS=0.25
PALIMPSEST_API_LEASE_TTL_SECONDS=30
PALIMPSEST_API_LEASE_HEARTBEAT_SECONDS=10
PALIMPSEST_API_DRAIN_TIMEOUT_SECONDS=30

# Async SQLAlchemy URL. Required at runtime startup, not at import time.
# PALIMPSEST_DATABASE_URL=postgresql+asyncpg://palimpsest:palimpsest@127.0.0.1:5432/palimpsest

# Disposable integration-test database. The name must contain palimpsest_test.
# PALIMPSEST_TEST_DATABASE_URL=postgresql+asyncpg://palimpsest:palimpsest@127.0.0.1:5432/palimpsest_test

PALIMPSEST_POOL_SIZE=5
PALIMPSEST_MAX_OVERFLOW=10
PALIMPSEST_POOL_TIMEOUT_SECONDS=30

# Optional composition-layer seed default. Always copied into SimulationRunConfig;
# never used as an implicit global RNG seed.
# PALIMPSEST_DEFAULT_RUN_SEED=42

# LLM provider (disabled by default). A future cognition consumer maps these
# into llm.factory.ProviderFactoryConfig and owns provider lifecycle.
# Do not put credentials or full endpoint URLs in logs.
PALIMPSEST_LLM_ADAPTER_KIND=disabled
# PALIMPSEST_LLM_ADAPTER_KIND=openai_compatible
# PALIMPSEST_LLM_MODEL=llama3.2
# Local HTTP is limited to localhost / 127.0.0.1 / ::1; path must be /v1.
# PALIMPSEST_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PALIMPSEST_LLM_API_KEY=
# PALIMPSEST_LLM_STRUCTURED_OUTPUT_MODE=json_schema
# PALIMPSEST_LLM_TEMPERATURE=0
# PALIMPSEST_LLM_MAX_ATTEMPTS=3
# PALIMPSEST_LLM_PER_ATTEMPT_TIMEOUT_SECONDS=30
# PALIMPSEST_LLM_TOTAL_DEADLINE_SECONDS=
# PALIMPSEST_LLM_MAX_REQUEST_BYTES=1048576
# PALIMPSEST_LLM_MAX_RESPONSE_BYTES=1048576
# PALIMPSEST_LLM_MAX_HEADER_BYTES=8192
# PALIMPSEST_LLM_SEND_CORRELATION_HEADER=false
