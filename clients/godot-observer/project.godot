; Engine configuration file.
; Palimpsest Observer is a read-only 2D presentation client.

config_version=5

[application]

config/name="Palimpsest Observer"
config/description="Read-only 2D presentation of a Palimpsest observer stream."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.13, 0.16, 1)

[palimpsest]

log_level="DEBUG"
observer_origin=""
run_id=""
api_token=""
pixels_per_unit=8
