{
  "$schema": "https://opencode.ai/config.json",
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 24000
  },
  "permission": {
    "read": {
      "*/.venv": "deny",
      "*/.venv/*": "deny",
      "*/venv": "deny",
      "*/venv/*": "deny",
      "*/.uv": "deny",
      "*/.uv/*": "deny",
      "*/node_modules": "deny",
      "*/node_modules/*": "deny",
      "*/uv.lock": "deny",
      "*/__pycache__": "deny",
      "*/__pycache__/*": "deny",
      "*/.cache": "deny",
      "*/.cache/*": "deny",
      "*/.pytest_cache": "deny",
      "*/.pytest_cache/*": "deny",
      "*/.mypy_cache": "deny",
      "*/.mypy_cache/*": "deny",
      "*/.ruff_cache": "deny",
      "*/.ruff_cache/*": "deny",
      "*/.hypothesis": "deny",
      "*/.hypothesis/*": "deny",
      "*/.grimp_cache": "deny",
      "*/.grimp_cache/*": "deny",
      "*/.import_linter_cache": "deny",
      "*/.import_linter_cache/*": "deny",
      "*/.tox": "deny",
      "*/.tox/*": "deny",
      "*/.nox": "deny",
      "*/.nox/*": "deny",
      "*/.godot": "deny",
      "*/.godot/*": "deny",
      "*/build": "deny",
      "*/build/*": "deny",
      "*/dist": "deny",
      "*/dist/*": "deny",
      "*/htmlcov": "deny",
      "*/htmlcov/*": "deny",
      "*/docs/_build": "deny",
      "*/docs/_build/*": "deny",
      "*.egg-info": "deny",
      "*.egg-info/*": "deny",
      "*/.coverage": "deny",
      "*/.coverage.*": "deny",
      "*/coverage.xml": "deny",
      "*.pyc": "deny",
      "*.pyo": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "*/.idea": "deny",
      "*/.idea/*": "deny"
    }
  }
}
